# QuickBox 项目环境变量配置示例
# 复制此文件为 .env 并根据实际环境修改

# ============================================
# 通用配置
# ============================================
ENVIRONMENT=development  # 环境: development/production/staging

# 时区
TZ=Asia/Shanghai

# 语言
LANG=zh_CN.UTF-8

# ============================================
# 后端应用配置
# ============================================
# 应用名称
APP_NAME=quick-box-server

# 服务器端口
SERVER_PORT=8080

# 应用根路径
CONTEXT_PATH=/

# ============================================
# 文件存储配置
# ============================================
# 文件存储基础路径
FILE_STORAGE_BASE_PATH=/app/uploads

# 分片存储目录
FILE_STORAGE_CHUNKS_DIR=chunks

# 最终文件存储目录
FILE_STORAGE_FILES_DIR=files

# 临时文件存储目录
FILE_STORAGE_TEMP_DIR=temp

# 分片大小（字节）
FILE_UPLOAD_CHUNK_SIZE=5242880  # 5MB

# 最大文件大小（字节）
FILE_UPLOAD_MAX_SIZE=104857600  # 100MB

# 文件保留天数
APP_FILE_RETENTION_DAYS=7

# 文件清理间隔（小时）
APP_FILE_CLEANUP_INTERVAL_HOURS=24

# ============================================
# 取件码配置
# ============================================
# 取件码长度
APP_ACCESS_CODE_LENGTH=6

# 取件码过期时间（小时）
APP_ACCESS_CODE_EXPIRATION_HOURS=168  # 7天

# ============================================
# 上传会话配置
# ============================================
# 上传会话过期时间（小时）
APP_UPLOAD_SESSION_EXPIRATION_HOURS=24

# 每个文件的最大分片数
APP_UPLOAD_MAX_CHUNKS_PER_FILE=1000

# ============================================
# Redis 配置
# ============================================
# Redis 主机地址
REDIS_HOST=redis

# Redis 端口
REDIS_PORT=6379

# Redis 密码
REDIS_PASSWORD=

# Redis 数据库编号
REDIS_DATABASE=0

# Redis 连接超时时间（毫秒）
REDIS_TIMEOUT=30000

# Redis 连接池最大活跃连接数
REDIS_POOL_MAX_ACTIVE=16

# Redis 连接池最大空闲连接数
REDIS_POOL_MAX_IDLE=8

# Redis 连接池最小空闲连接数
REDIS_POOL_MIN_IDLE=4

# ============================================
# MinIO 配置（可选，仅当使用 MinIO 存储时需要）
# ============================================
# MinIO 服务地址
MINIO_ENDPOINT=http://minio:9000

# MinIO 访问密钥
MINIO_ACCESS_KEY=quickbox

# MinIO 密钥
MINIO_SECRET_KEY=quickbox123

# MinIO 存储桶名称
MINIO_BUCKET_NAME=quickbox-files

# 是否启用 HTTPS
MINIO_SECURE=false

# ============================================
# AWS S3 配置（可选，仅当使用 AWS S3 存储时需要）
# ============================================
# AWS S3 服务地址
AWS_S3_ENDPOINT=https://s3.amazonaws.com

# AWS 访问密钥
AWS_ACCESS_KEY=

# AWS 密钥
AWS_SECRET_KEY=

# S3 存储桶名称
AWS_BUCKET_NAME=

# AWS 区域
AWS_REGION=us-east-1

# ============================================
# 前端配置
# ============================================
# API 基础路径
VITE_API_BASE_URL=/api

# 上传分片大小（字节）
VITE_UPLOAD_CHUNK_SIZE=5242880  # 5MB

# 并发上传数量
VITE_UPLOAD_CONCURRENT=3

# ============================================
# Nginx 配置
# ============================================
# 服务器名称
NGINX_SERVER_NAME=localhost

# 前端根路径
NGINX_ROOT=/usr/share/nginx/html

# 后端代理地址
NGINX_BACKEND_PROXY=http://backend:8080

# ============================================
# 监控配置
# ============================================
# Spring Boot Admin 地址
SPRING_BOOT_ADMIN_URL=

# Spring Boot Admin 用户名
SPRING_BOOT_ADMIN_USERNAME=

# Spring Boot Admin 密码
SPRING_BOOT_ADMIN_PASSWORD=

# ============================================
# 日志配置
# ============================================
# 日志级别（DEBUG/INFO/WARN/ERROR）
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=/app/logs/quick-box-server.log

# ============================================
# JVM 配置
# ============================================
# JVM 堆内存大小
JVM_XMS=1g
JVM_XMX=2g

# GC 日志
JVM_GC_LOG=/app/logs/gc.log

# ============================================
# 安全配置
# ============================================
# CORS 允许的来源
CORS_ALLOWED_ORIGINS=*

# CORS 允许的方法
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS

# CORS 允许的头部
CORS_ALLOWED_HEADERS=*

# ============================================
# 数据库配置（可选，未来扩展）
# ============================================
# 数据库类型
DB_TYPE=mysql

# 数据库主机
DB_HOST=localhost

# 数据库端口
DB_PORT=3306

# 数据库名称
DB_NAME=quickbox

# 数据库用户名
DB_USERNAME=root

# 数据库密码
DB_PASSWORD=

# ============================================
# 邮件配置（可选，未来扩展）
# ============================================
# 邮件服务器地址
MAIL_HOST=smtp.gmail.com

# 邮件服务器端口
MAIL_PORT=587

# 邮件服务器用户名
MAIL_USERNAME=

# 邮件服务器密码
MAIL_PASSWORD=

# 邮件发送者
MAIL_FROM=noreply@quickbox.com
